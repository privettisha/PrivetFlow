{
  "manifest_version": 3,
  "name": "PrivetFlow",
  "version": "1.0.0",
  "minimum_chrome_version": "111",
  "description": "Локальный помощник региональной доступности Google Flow. Управление и диагностика без телеметрии.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://flow.google.com/*"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "PrivetFlow"},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'"}
}
